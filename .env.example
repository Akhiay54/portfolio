# Public site URL, no trailing slash. Used for canonical, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# EmailJS (https://dashboard.emailjs.com) — required for the contact form to send.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=